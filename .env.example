# Copy to .env and fill in your values. .env is gitignored.

# Base URL of your n8n instance (no trailing slash).
# Example: https://n8n.yourdomain.com
N8N_BASE_URL=https://your-n8n-instance.example.com

# n8n REST API key. Generate one in n8n Settings → n8n API.
N8N_API_KEY=your-api-key-here

# Tag used to mark workflows for the showcase.
# Workflows tagged with this will be pulled by `npm run sync-workflows`.
N8N_SHOWCASE_TAG=evolution
